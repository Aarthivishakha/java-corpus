<?xml version="1.0" encoding="UTF-8"?>
<project name="jv-020" default="package" basedir="."
         xmlns:ivy="antlib:org.apache.ivy.ant">

  <property name="java.source" value="1.8"/>
  <property name="java.target" value="1.8"/>
  <property name="build.dir"   value="build"/>
  <property name="dist.dir"    value="dist"/>
  <property name="lib.dir"     value="lib"/>
  <property name="report.dir"  value="${build.dir}/reports"/>

  <target name="resolve" description="fetch dependencies with Ivy">
    <mkdir dir="${lib.dir}"/>
    <ivy:retrieve pattern="${lib.dir}/[artifact]-[revision].[ext]"/>
  </target>

  <target name="compile" depends="resolve" description="compile main sources at Java 8">
    <mkdir dir="${build.dir}/classes"/>
    <javac destdir="${build.dir}/classes" includeantruntime="false"
           source="${java.source}" target="${java.target}" debug="true" encoding="UTF-8">
      <src path="jv-020-domain/src/main/java"/>
      <src path="jv-020-pricing/src/main/java"/>
      <src path="jv-020-risk/src/main/java"/>
      <src path="jv-020-catalog/src/main/java"/>
      <classpath><fileset dir="${lib.dir}" includes="**/*.jar"/></classpath>
    </javac>
  </target>

  <target name="compile-tests" depends="compile" description="compile test sources">
    <mkdir dir="${build.dir}/test-classes"/>
    <javac srcdir="jv-020-domain/src/test/java" destdir="${build.dir}/test-classes" includeantruntime="false"
           source="${java.source}" target="${java.target}" debug="true" encoding="UTF-8">
      <classpath>
        <pathelement location="${build.dir}/classes"/>
        <fileset dir="${lib.dir}" includes="**/*.jar"/>
      </classpath>
    </javac>
  </target>

  <target name="test" depends="compile-tests" description="run the JUnit suite">
    <mkdir dir="${report.dir}"/>
    <junit printsummary="true" haltonfailure="true" fork="true">
      <classpath>
        <pathelement location="${build.dir}/classes"/>
        <pathelement location="${build.dir}/test-classes"/>
        <fileset dir="${lib.dir}" includes="**/*.jar"/>
      </classpath>
      <formatter type="xml"/>
      <batchtest todir="${report.dir}">
        <fileset dir="jv-020-domain/src/test/java" includes="**/*Test.java"/>
      </batchtest>
    </junit>
  </target>

  <target name="package" depends="compile" description="thin jar; dependencies stay in lib/">
    <mkdir dir="${dist.dir}/lib"/>
    <copy todir="${dist.dir}/lib" flatten="true">
      <fileset dir="${lib.dir}" includes="**/*.jar"/>
    </copy>
    <pathconvert property="manifest.classpath" pathsep=" ">
      <mapper><chainedmapper>
        <flattenmapper/><globmapper from="*" to="lib/*"/>
      </chainedmapper></mapper>
      <path><fileset dir="${dist.dir}/lib" includes="*.jar"/></path>
    </pathconvert>
    <jar destfile="${dist.dir}/${ant.project.name}.jar" basedir="${build.dir}/classes">
      <manifest>
        <attribute name="Main-Class" value="com.pramora.testable.app.Main"/>
        <attribute name="Class-Path" value="${manifest.classpath}"/>
      </manifest>
    </jar>
  </target>

  <target name="clean" description="remove build output">
    <delete dir="${build.dir}"/>
    <delete dir="${dist.dir}"/>
  </target>
</project>
