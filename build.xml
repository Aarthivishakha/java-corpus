<?xml version="1.0" encoding="UTF-8"?>
<project name="jv-240" default="package" basedir="."
         xmlns:ivy="antlib:org.apache.ivy.ant">

  <!-- release, not source/target: it pins the API surface as well as the bytecode level,
       matching how this family is verified. Ant's javac task has carried the release
       attribute since 1.9.8; this family pins Ant 1.10.14. -->
  <property name="java.release" value="14"/>
  <property name="build.dir"   value="build"/>
  <property name="dist.dir"    value="dist"/>
  <property name="lib.dir"     value="lib"/>
  <property name="report.dir"  value="${build.dir}/reports"/>

  <target name="resolve" description="fetch dependencies with Ivy">
    <mkdir dir="${lib.dir}"/>
    <ivy:retrieve pattern="${lib.dir}/[artifact]-[revision].[ext]"/>
  </target>

  <target name="compile" depends="resolve" description="compile main sources at Java 14">
    <mkdir dir="${build.dir}/classes"/>
    <javac destdir="${build.dir}/classes" includeantruntime="false"
           release="${java.release}" debug="true" encoding="UTF-8">
      <src path="jv-240-domain/src/main/java"/>
      <src path="jv-240-pricing/src/main/java"/>
      <src path="jv-240-risk/src/main/java"/>
      <src path="jv-240-catalog/src/main/java"/>
      <classpath><fileset dir="${lib.dir}" includes="**/*.jar"/></classpath>
    </javac>
  </target>

  <target name="compile-tests" depends="compile" description="compile test sources">
    <mkdir dir="${build.dir}/test-classes"/>
    <javac srcdir="jv-240-domain/src/test/java" destdir="${build.dir}/test-classes" includeantruntime="false"
           release="${java.release}" debug="true" encoding="UTF-8">
      <classpath>
        <pathelement location="${build.dir}/classes"/>
        <fileset dir="${lib.dir}" includes="**/*.jar"/>
      </classpath>
    </javac>
  </target>

  <target name="test" depends="compile-tests" description="run the JUnit suite">
    <mkdir dir="${report.dir}"/>
    <junit printsummary="true" haltonfailure="true" fork="true">
      <classpath>
        <pathelement location="${build.dir}/classes"/>
        <pathelement location="${build.dir}/test-classes"/>
        <fileset dir="${lib.dir}" includes="**/*.jar"/>
      </classpath>
      <formatter type="xml"/>
      <batchtest todir="${report.dir}">
        <fileset dir="jv-240-domain/src/test/java" includes="**/*Test.java"/>
      </batchtest>
    </junit>
  </target>

  <target name="package" depends="compile" description="WAR: WEB-INF/classes + WEB-INF/lib">
    <war destfile="${dist.dir}/${ant.project.name}.war"
         webxml="src/main/webapp/WEB-INF/web.xml" needxmlfile="true">
      <classes dir="${build.dir}/classes"/>
      <lib dir="${lib.dir}" includes="**/*.jar" excludes="javax.servlet-api*.jar"/>
    </war>
  </target>

  <target name="clean" description="remove build output">
    <delete dir="${build.dir}"/>
    <delete dir="${dist.dir}"/>
  </target>
</project>
